{
  "title": "IP top lists (ip-agg-streams)",
  "uid": "ip-agg-streams",
  "tags": [
    "ip-agg",
    "kafka-streams"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Prometheus",
        "current": {}
      },
      {
        "name": "topn",
        "type": "custom",
        "label": "Top N",
        "query": "10,20,50,100",
        "current": {
          "text": "20",
          "value": "20"
        },
        "options": [
          {
            "text": "10",
            "value": "10",
            "selected": false
          },
          {
            "text": "20",
            "value": "20",
            "selected": true
          },
          {
            "text": "50",
            "value": "50",
            "selected": false
          },
          {
            "text": "100",
            "value": "100",
            "selected": false
          }
        ]
      },
      {
        "name": "method",
        "type": "query",
        "label": "Method",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "refresh": 2,
        "sort": 1,
        "query": {
          "query": "label_values(ip_agg_route_top_ip_requests, method)",
          "refId": "m"
        },
        "definition": "label_values(ip_agg_route_top_ip_requests, method)"
      },
      {
        "name": "route",
        "type": "query",
        "label": "Route",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "refresh": 2,
        "sort": 1,
        "query": {
          "query": "label_values(ip_agg_route_top_ip_requests{method=\"$method\"}, route)",
          "refId": "r"
        },
        "definition": "label_values(ip_agg_route_top_ip_requests{method=\"$method\"}, route)"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Last closed window",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "id": 100,
      "panels": []
    },
    {
      "id": 1,
      "title": "Top IPs",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "topk($topn, max by (ip) (ip_agg_top_ip_requests))",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "description": "Requests per client IP over all methods and routes, last closed 1-minute window. Exact: every IP lives on one instance (max by (ip) also hides a duplicate during a rebalance).",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "requests / window"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "requests / window",
                "desc": true
              }
            ]
          }
        }
      ]
    },
    {
      "id": 2,
      "title": "Top IP + endpoint",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 9,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "topk($topn, max by (ip, method, route) (ip_agg_top_ip_route_requests))",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "description": "Which IP hits which endpoint the most. Not the same as Top IPs: an IP spread over many routes can top that list without any top pair.",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "requests / window"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "requests / window",
                "desc": true
              }
            ]
          }
        }
      ]
    },
    {
      "id": 3,
      "title": "Top IPs for $method $route",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 15,
        "y": 1,
        "w": 9,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "topk($topn, max by (ip) (ip_agg_route_top_ip_requests{method=\"$method\", route=\"$route\"}))",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "description": "Top IPs of one endpoint (pick it above). Only the busiest MAX_ROUTES routes per window have a list, each with TOP_IPS_PER_ROUTE IPs.",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "requests / window"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "requests / window",
                "desc": true
              }
            ]
          }
        }
      ]
    },
    {
      "type": "row",
      "title": "Over time",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 1
      },
      "id": 113,
      "panels": []
    },
    {
      "id": 4,
      "title": "Top 10 IPs per window",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "topk(10, max by (ip) (ip_agg_top_ip_requests))",
          "instant": false,
          "range": true,
          "legendFormat": "{{ip}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "Unique IPs and requests per window",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(ip_agg_unique_ips)",
          "instant": false,
          "range": true,
          "legendFormat": "unique IPs"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(ip_agg_requests)",
          "instant": false,
          "range": true,
          "legendFormat": "requests"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "type": "row",
      "title": "Pipeline health",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 24,
        "h": 1
      },
      "id": 123,
      "panels": []
    },
    {
      "id": 6,
      "title": "Seconds since last push",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "time() - max by (instance) (ip_agg_last_push_timestamp_seconds)",
          "instant": false,
          "range": true,
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {},
      "description": "Each pod pushes once per window; above ~2 minutes the pod is stuck or cannot reach Prometheus."
    },
    {
      "id": 7,
      "title": "Consumer lag (records)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 6,
        "y": 24,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (pod, topic) (kafka_consumer_fetch_manager_records_lag_max{service=\"ip-agg-streams\"})",
          "instant": false,
          "range": true,
          "legendFormat": "{{pod}} {{topic}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "title": "Input spans/s by outcome",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (result) (rate(ipagg_input_spans_total{service=\"ip-agg-streams\"}[5m]))",
          "instant": false,
          "range": true,
          "legendFormat": "{{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 9,
      "title": "Remote write series/s by result",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 18,
        "y": 24,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (result) (rate(ipagg_remote_write_series_total{service=\"ip-agg-streams\"}[5m]))",
          "instant": false,
          "range": true,
          "legendFormat": "{{result}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(ipagg_input_messages_failed_total{service=\"ip-agg-streams\"}[5m]))",
          "instant": false,
          "range": true,
          "legendFormat": "undecodable messages"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 10,
      "title": "Window emit delay",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (pod) (ipagg_window_emit_delay_seconds{service=\"ip-agg-streams\"})",
          "instant": false,
          "range": true,
          "legendFormat": "{{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {},
      "description": "Wall clock minus window end when the window was pushed: ~grace (10s) plus the 5s check interval when healthy, up to grace + max-wait when a partition is idle or lagging."
    },
    {
      "id": 11,
      "title": "Series pushed per window (views)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count by (instance) ({__name__=~\"ip_agg_top_ip_requests|ip_agg_top_ip_route_requests|ip_agg_route_top_ip_requests\", job=\"ip-agg-streams\"})",
          "instant": false,
          "range": true,
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "description": "Should stay at about TOP_IPS + TOP_PAIRS + routes x TOP_IPS_PER_ROUTE per pod, however many IPs there are."
    }
  ]
}